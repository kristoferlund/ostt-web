#!/usr/bin/env bash
set -euo pipefail

REPO="kristoferlund/ostt"
APP_NAME="OSTT"
BIN_NAME="ostt"
# Source of truth for the latest release: every download URL and checksum is
# read from here rather than reconstructed from filename patterns.
MANIFEST_URL="${OSTT_MANIFEST_URL:-https://ostt.ai/latest.json}"
MANIFEST=""
# Set by resolve_asset().
RESOLVED_URL=""
RESOLVED_SHA=""
# Set by install_build() / download_and_install(): the variant actually
# installed (which can differ from the one detected when a release does not
# publish it), where it landed, and by which method.
INSTALLED_VARIANT=""
INSTALLED_BIN=""
INSTALL_MODE_USED=""
# Set by has_ld_library(): whether the last positive answer came only from
# LD_LIBRARY_PATH rather than the loader cache.
LD_LIBRARY_PATH_HIT=0
DEFAULT_INSTALL_DIR="$HOME/.local/bin"
INSTALL_DIR="${OSTT_INSTALL_DIR:-$DEFAULT_INSTALL_DIR}"
VERSION="latest"
INTERACTIVE=0
INSTALL_DEPS=1
GPU_MODE="auto"
MODIFY_PATH=1
CONFIGURE_OMARCHY=1
DOWNLOAD_MODEL=1

# Network hardening applied to every curl invocation.
CURL_OPTS=(--retry 3 --retry-connrefused --connect-timeout 10)

usage() {
  cat <<'EOF'
OSTT installer

Usage:
  curl -fsSL https://ostt.ai/install | bash

Runs non-interactively by default. Pass -i to see a summary of what will be
installed and confirm before it runs.

Options:
  -i, --interactive     Ask for confirmation before installing
      --no-deps         Do not install system dependencies
      --gpu MODE        Force a build instead of detecting one. MODE is auto
                        (default), cuda (CUDA 12), cuda13 (CUDA 13), vulkan,
                        or cpu
      --no-gpu          Install the CPU build even if GPU support is detected
      --no-modify-path  Do not add the install directory to your shell profile
      --no-omarchy-setup
                        Do not configure Omarchy hotkeys, popup rules, or agent action
      --no-model-download
                        Do not offer to download the Whisper base model
      --version VERSION Install a specific version, for example v0.0.8
      --install-dir DIR Install ostt to DIR (default: ~/.local/bin)
  -y, --yes             Accepted for compatibility; this is now the default
  -h, --help            Show this help
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
  -y | --yes)
    # Non-interactive is the default now; kept so existing docs and muscle
    # memory keep working.
    shift
    ;;
  -i | --interactive)
    INTERACTIVE=1
    shift
    ;;
  --no-modify-path)
    MODIFY_PATH=0
    shift
    ;;
  --no-omarchy-setup)
    CONFIGURE_OMARCHY=0
    shift
    ;;
  --no-model-download)
    DOWNLOAD_MODEL=0
    shift
    ;;
  --no-deps)
    INSTALL_DEPS=0
    shift
    ;;
  --no-gpu)
    GPU_MODE="cpu"
    shift
    ;;
  --gpu)
    GPU_MODE="${2:-}"
    case "$GPU_MODE" in
    auto | cpu | cuda | cuda13 | vulkan) ;;
    *)
      echo "error: --gpu expects auto, cpu, cuda, cuda13, or vulkan" >&2
      exit 1
      ;;
    esac
    shift 2
    ;;
  --version)
    VERSION="${2:-}"
    if [ -z "$VERSION" ]; then
      echo "error: --version requires a value" >&2
      exit 1
    fi
    shift 2
    ;;
  --install-dir)
    INSTALL_DIR="${2:-}"
    if [ -z "$INSTALL_DIR" ]; then
      echo "error: --install-dir requires a value" >&2
      exit 1
    fi
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "error: unknown option: $1" >&2
    usage >&2
    exit 1
    ;;
  esac
done

log() {
  printf '%s\n' "$*"
}

print_header() {
  printf '\n'
  printf '┏┓┏╋╋\n'
  printf '┗┛┛┗┗\n'
  printf '\n'
  printf '\033[42;30m Install \033[0m\n'
  printf '\n'
}

warn() {
  printf 'warning: %s\n' "$*" >&2
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

has() {
  command -v "$1" >/dev/null 2>&1
}

confirm() {
  if [ "$INTERACTIVE" -eq 0 ]; then
    return 0
  fi

  printf 'Continue? [Y/n] '
  read -r answer 2>/dev/null </dev/tty || return 0
  printf '\n'
  case "$answer" in
  '' | Y | y | YES | Yes | yes) return 0 ;;
  *) die "installation cancelled" ;;
  esac
}

need() {
  if ! has "$1"; then
    die "'$1' is required but was not found. Install it and rerun, or download a release manually from https://github.com/${REPO}/releases"
  fi
}

check_prerequisites() {
  need curl
  need tar
  need awk

  if ! has sha256sum && ! has shasum && ! has openssl; then
    die "checksum verification requires sha256sum, shasum, or openssl"
  fi
}

sudo_cmd() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  else
    if ! has sudo; then
      die "sudo is required to install system dependencies"
    fi
    sudo "$@"
  fi
}

detect_os() {
  case "$(uname -s)" in
  Darwin) echo "macos" ;;
  Linux) echo "linux" ;;
  *) die "unsupported operating system: $(uname -s)" ;;
  esac
}

detect_arch() {
  case "$(uname -m)" in
  x86_64 | amd64) echo "x86_64" ;;
  arm64 | aarch64) echo "aarch64" ;;
  *) die "unsupported CPU architecture: $(uname -m)" ;;
  esac
}

detect_distro() {
  if [ -r /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    echo "${ID:-unknown}"
  else
    echo "unknown"
  fi
}

detect_package_manager() {
  local os="$1"

  if [ "$os" = "macos" ]; then
    if has brew; then
      echo "brew"
      return
    fi
  else
    if has apt-get; then
      echo "apt"
      return
    fi
    if has dnf; then
      echo "dnf"
      return
    fi
    if has zypper; then
      echo "zypper"
      return
    fi
    if has pacman; then
      echo "pacman"
      return
    fi
  fi

  echo "unknown"
}

detect_session() {
  case "${XDG_SESSION_TYPE:-}" in
  wayland) echo "wayland" ;;
  x11) echo "x11" ;;
  *)
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
      echo "wayland"
    elif [ -n "${DISPLAY:-}" ]; then
      echo "x11"
    else
      echo "unknown"
    fi
    ;;
  esac
}

target_triple() {
  local os="$1"
  local arch="$2"

  case "$os:$arch" in
  macos:x86_64) echo "x86_64-apple-darwin" ;;
  macos:aarch64) echo "aarch64-apple-darwin" ;;
  linux:x86_64) echo "x86_64-unknown-linux-gnu" ;;
  linux:aarch64) echo "aarch64-unknown-linux-gnu" ;;
  *) die "unsupported platform: $os $arch" ;;
  esac
}

installed_ostt_path() {
  if [ -x "${INSTALL_DIR}/${BIN_NAME}" ]; then
    printf '%s\n' "${INSTALL_DIR}/${BIN_NAME}"
    return 0
  fi

  command -v "$BIN_NAME" 2>/dev/null || true
}

installed_ostt_version() {
  local path="$1"
  local raw

  if [ -z "$path" ] || [ ! -x "$path" ]; then
    return 0
  fi

  raw="$($path --version 2>/dev/null || true)"
  # Take the first *matching* line, as `sed ... | head -n 1` did, but pick it
  # off in the shell afterwards. Piping into `head` would SIGPIPE sed once the
  # producer exceeds the pipe buffer, and under `set -o pipefail` that failure
  # propagates out of this `var="$(...)"` assignment and aborts the installer.
  raw="$(printf '%s\n' "$raw" | sed -n 's/.*\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/v\1/p')"
  printf '%s\n' "${raw%%$'\n'*}"
}

fetch_manifest() {
  MANIFEST="$(curl "${CURL_OPTS[@]}" --max-time 20 -fsSL "$MANIFEST_URL" 2>/dev/null || true)"

  # Deliberately fatal rather than falling back to constructing filenames: a
  # silent fallback would hide a stale or unpublished manifest indefinitely.
  if [ -z "$MANIFEST" ]; then
    die "could not fetch the release manifest at ${MANIFEST_URL}
  Check your connection and try again. To bypass the manifest entirely,
  install a pinned version: curl -fsSL https://ostt.ai/install | bash -s -- --version vX.Y.Z"
  fi
}

# Read a "key": "value" pair out of one top-level object in the manifest.
# Values never contain a quote, so this stays a two-substitution job.
manifest_get() {
  local section="$1"
  local key="$2"

  # awk reads the whole manifest rather than `exit`ing on the first hit: an
  # early exit would SIGPIPE the producer once the manifest outgrows the pipe
  # buffer, and under `set -o pipefail` that fails the bare assignments that
  # call this. The manifest is a few KB, so reading it all costs nothing.
  printf '%s\n' "$MANIFEST" | awk -v section="\"$section\"" -v target="\"$key\":" '
    found { next }
    $0 ~ "^[[:space:]]*" section "[[:space:]]*:" { in_section = 1; next }
    in_section && /^[[:space:]]*}/ { in_section = 0; next }
    in_section && index($0, target) {
      sub(/^.*:[[:space:]]*"/, "")
      sub(/".*$/, "")
      print
      found = 1
    }
  '
}

manifest_version() {
  printf '%s\n' "$MANIFEST" | awk -F '"' '!found && /^[[:space:]]*"version"[[:space:]]*:/ { print $4; found = 1 }'
}

# Manifest key for a platform: linux-x86_64, linux-x86_64-cuda-deb, and so on.
# macOS ships Metal in the base archive, so "metal" adds no suffix.
manifest_key() {
  local os="$1"
  local arch="$2"
  local gpu_variant="$3"
  local kind="$4"
  local key="${os}-${arch}"

  case "$gpu_variant" in
  cuda | cuda13 | vulkan) key="${key}-${gpu_variant}" ;;
  esac

  case "$kind" in
  deb | rpm) key="${key}-${kind}" ;;
  esac

  printf '%s\n' "$key"
}

# Warn when the published manifest has fallen behind the newest GitHub
# release, which means the manifest refresh step of a release was skipped.
# Advisory only: any failure here is ignored rather than blocking an install.
warn_if_manifest_stale() {
  local effective_url latest

  effective_url="$(curl "${CURL_OPTS[@]}" --max-time 10 -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/${REPO}/releases/latest" 2>/dev/null || true)"
  [ -n "$effective_url" ] || return 0

  latest="${effective_url##*/}"
  latest="${latest#v}"
  [ -n "$latest" ] || return 0

  if [ "$latest" != "${VERSION#v}" ]; then
    warn "the install manifest offers v${VERSION#v}, but v${latest} is the newest release"
    warn "installing v${VERSION#v} anyway; please report this at https://github.com/${REPO}/issues"
  fi
}

# Sets RESOLVED_URL and RESOLVED_SHA for the requested target. For the default
# "latest" install both come from the manifest. A pinned --version predates the
# manifest, so that path still derives names from the release layout.
resolve_asset() {
  local os="$1"
  local arch="$2"
  local gpu_variant="$3"
  local kind="$4"
  local key name

  RESOLVED_URL=""
  RESOLVED_SHA=""

  if [ -n "$MANIFEST" ]; then
    key="$(manifest_key "$os" "$arch" "$gpu_variant" "$kind")"
    RESOLVED_URL="$(manifest_get assets "$key")"
    RESOLVED_SHA="$(manifest_get sha256 "$key")"

    if [ -z "$RESOLVED_URL" ]; then
      return 1
    fi
    if [ -z "$RESOLVED_SHA" ]; then
      die "manifest lists ${key} but has no checksum for it; refusing to install unverified"
    fi
    return 0
  fi

  name="$(legacy_asset_name "$os" "$arch" "$gpu_variant" "$kind")" || return 1
  RESOLVED_URL="$(release_base_url)/${name}"

  # No manifest to read the digest from, so use the .sha256 published beside
  # the asset. An empty RESOLVED_SHA tells the caller to fetch that sibling.
  if ! curl "${CURL_OPTS[@]}" --max-time 20 -fsI "$RESOLVED_URL" >/dev/null 2>&1; then
    return 1
  fi
  return 0
}

legacy_asset_name() {
  local os="$1"
  local arch="$2"
  local gpu_variant="$3"
  local kind="$4"
  local ver="${VERSION#v}"
  local triple

  case "$kind" in
  deb | rpm)
    case "$kind:$arch:$gpu_variant" in
    deb:x86_64:cuda) printf '%s\n' "ostt-cuda_${ver}-1_amd64.deb" ;;
    deb:x86_64:cuda13) printf '%s\n' "ostt-cuda13_${ver}-1_amd64.deb" ;;
    deb:x86_64:vulkan) printf '%s\n' "ostt-vulkan_${ver}-1_amd64.deb" ;;
    deb:x86_64:*) printf '%s\n' "ostt_${ver}-1_amd64.deb" ;;
    deb:aarch64:*) printf '%s\n' "ostt_${ver}-1_arm64.deb" ;;
    rpm:x86_64:cuda) printf '%s\n' "ostt-cuda-${ver}-1.x86_64.rpm" ;;
    rpm:x86_64:cuda13) printf '%s\n' "ostt-cuda13-${ver}-1.x86_64.rpm" ;;
    rpm:x86_64:vulkan) printf '%s\n' "ostt-vulkan-${ver}-1.x86_64.rpm" ;;
    rpm:x86_64:*) printf '%s\n' "ostt-${ver}-1.x86_64.rpm" ;;
    rpm:aarch64:*) printf '%s\n' "ostt-${ver}-1.aarch64.rpm" ;;
    *) return 1 ;;
    esac
    ;;
  *)
    triple="$(target_triple "$os" "$arch")"
    case "$gpu_variant" in
    cuda | cuda13 | vulkan) printf '%s\n' "ostt-${ver}-${triple}-${gpu_variant}.tar.gz" ;;
    *) printf '%s\n' "ostt-${triple}.tar.gz" ;;
    esac
    ;;
  esac
}

# Downloads $url to $dest and verifies it. Uses $sha when the manifest supplied
# one, otherwise falls back to the .sha256 sibling of the asset.
download_verified() {
  local url="$1"
  local sha="$2"
  local dest="$3"
  local checksum_url

  log "Downloading ${url}"
  # A listed asset can still fail to download (renamed, a half-published
  # release, an outage outlasting the retries). Report it and let the caller
  # decide whether another build can be tried, rather than aborting here.
  if ! curl "${CURL_OPTS[@]}" --max-time 300 -fsSL "$url" -o "$dest"; then
    warn "could not download $(basename "$url")"
    return 1
  fi

  if [ -z "$sha" ]; then
    checksum_url="${url}.sha256"
    log "Downloading ${checksum_url}"
    sha="$(curl "${CURL_OPTS[@]}" --max-time 30 -fsSL "$checksum_url" 2>/dev/null | awk '{print $1}')"
    if [ -z "$sha" ]; then
      die "could not fetch a checksum for $(basename "$url")"
    fi
  fi

  verify_checksum "$dest" "$sha"
}

# Directories the dynamic loader will search for the binary we are about to
# install, beyond what is in the ldconfig cache. LD_LIBRARY_PATH is inherited
# from the environment this script runs in, so a library found there really
# will resolve at runtime.
ld_library_path_dirs() {
  [ -n "${LD_LIBRARY_PATH:-}" ] || return 0
  printf '%s\n' "${LD_LIBRARY_PATH//:/$'\n'}"
  return 0
}

# Where distributions and NVIDIA's own installers put a CUDA toolkit. Consulted
# only when there is no ldconfig cache to ask, because a library sitting in one
# of these directories is not necessarily on the loader's search path -- and a
# library the loader cannot find is of no use to the binary we are installing.
toolkit_search_dirs() {
  local dir

  for dir in \
    /usr/lib \
    /usr/lib64 \
    /usr/lib/x86_64-linux-gnu \
    /usr/local/lib \
    /usr/local/lib64 \
    /opt/cuda/lib64 \
    /opt/cuda/targets/x86_64-linux/lib \
    /usr/local/cuda/lib64 \
    /usr/local/cuda/targets/x86_64-linux/lib; do
    printf '%s\n' "$dir"
  done

  if [ -n "${CUDA_HOME:-}" ]; then
    printf '%s\n' "${CUDA_HOME}/lib64"
  fi
  if [ -n "${CUDA_PATH:-}" ]; then
    printf '%s\n' "${CUDA_PATH}/lib64"
  fi

  # Versioned prefixes, for when the unversioned /usr/local/cuda symlink is absent.
  for dir in /usr/local/cuda-*/lib64 /usr/local/cuda-*/targets/x86_64-linux/lib; do
    if [ -d "$dir" ]; then
      printf '%s\n' "$dir"
    fi
  done

  return 0
}

# True when the dynamic loader can be expected to resolve $lib at runtime.
#
# The question this answers is deliberately narrow. Finding the file on disk is
# not enough: picking a GPU build whose libraries the loader cannot reach leaves
# the user with a binary that will not start, which is a worse outcome than
# installing the CPU build. So the ldconfig cache is treated as authoritative
# when it exists, and the on-disk scan is reserved for systems that have no
# cache to consult at all.
has_ld_library() {
  local lib="$1"
  local cache dir

  LD_LIBRARY_PATH_HIT=0
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    if dir_has_library "$dir" "$lib"; then
      # This only proves the library resolves for the current process. Whether
      # it resolves in the user's login shell depends on where they set the
      # variable, so the caller warns about it.
      LD_LIBRARY_PATH_HIT=1
      return 0
    fi
  done < <(ld_library_path_dirs)

  # Read the cache into a variable rather than piping it into grep. Under
  # `set -o pipefail`, `ldconfig -p | grep -q` reports failure whenever grep
  # matches early enough to SIGPIPE ldconfig, which on a large cache silently
  # hides libraries that are in fact installed.
  if has ldconfig; then
    cache="$(ldconfig -p 2>/dev/null || true)"
    if [ -n "$cache" ]; then
      case "$cache" in
      *"$lib"*) return 0 ;;
      esac
      return 1
    fi
  fi

  # No cache to consult: minimal containers and images without ldconfig. Fall
  # back to scanning the usual toolkit locations.
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    if dir_has_library "$dir" "$lib"; then
      return 0
    fi
  done < <(toolkit_search_dirs)

  return 1
}

# True when $1 contains a file whose name starts with $2. The directory is
# quoted so glob metacharacters in it (a bracket in an LD_LIBRARY_PATH entry)
# stay literal; only the name suffix is a pattern.
dir_has_library() {
  local f

  for f in "$1"/"$2"*; do
    if [ -e "$f" ]; then
      return 0
    fi
  done

  return 1
}

# Artifact variant name for a CUDA major version. CUDA 12 keeps the historical
# unsuffixed "cuda" name so existing release assets stay valid.
cuda_variant_for_major() {
  case "$1" in
  13) printf '%s\n' "cuda13" ;;
  12) printf '%s\n' "cuda" ;;
  *) return 1 ;;
  esac
}

# Lowest compute capability across every GPU in the machine, for example "6.1".
# Empty when unknown, which includes the cases where nvidia-smi is absent, is
# too old to know the compute_cap field, or reports [N/A] for it.
#
# The minimum is what matters, not the first GPU: a build has to have kernels
# for every device it might be asked to run on, and the order nvidia-smi
# enumerates them in is not something to depend on.
nvidia_compute_cap() {
  local line cap="" lowest=""

  has nvidia-smi || return 0

  while IFS= read -r line; do
    cap="${line//[[:space:]]/}"
    # Accept "8.6" and a bare "8" (normalised to "8.0"); skip [N/A], error
    # text, and anything else that is not a capability.
    case "$cap" in
    [0-9]*.[0-9]*) ;;
    [0-9]*) cap="${cap}.0" ;;
    *) continue ;;
    esac
    case "$cap" in
    *[!0-9.]*) continue ;;
    esac
    if [ -z "$lowest" ] || compute_cap_lt "$cap" "$lowest"; then
      lowest="$cap"
    fi
  done <<EOF
$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null || true)
EOF

  printf '%s\n' "$lowest"
}

# True when compute capability $1 is lower than $2. Both are "<major>.<minor>".
compute_cap_lt() {
  local a_major="${1%%.*}" a_minor="${1#*.}"
  local b_major="${2%%.*}" b_minor="${2#*.}"

  case "$a_minor" in '' | *[!0-9]*) a_minor=0 ;; esac
  case "$b_minor" in '' | *[!0-9]*) b_minor=0 ;; esac

  if [ "$a_major" -ne "$b_major" ]; then
    [ "$a_major" -lt "$b_major" ]
    return
  fi
  [ "$a_minor" -lt "$b_minor" ]
}

# CUDA 13 dropped offline compilation for Maxwell, Pascal, and Volta, so the
# cuda13 build carries no kernels for compute capability below 7.5. Those GPUs
# need the CUDA 12 build (or Vulkan) even when a CUDA 13 toolkit is installed.
supports_cuda13() {
  local cap major minor

  cap="$(nvidia_compute_cap)"

  # Unknown capability: assume supported rather than refuse a working build.
  [ -n "$cap" ] || return 0

  major="${cap%%.*}"
  minor="${cap#*.}"
  case "$major" in
  '' | *[!0-9]*) return 0 ;;
  esac
  case "$minor" in
  '' | *[!0-9]*) minor=0 ;;
  esac

  if [ "$major" -gt 7 ]; then
    return 0
  fi
  if [ "$major" -eq 7 ] && [ "$minor" -ge 5 ]; then
    return 0
  fi
  return 1
}

# True when an NVIDIA Vulkan ICD manifest is installed. The loader finds ICDs
# through these directories; the NVIDIA one is named nvidia_icd.json or
# nvidia_icd.<arch>.json depending on the packaging.
has_nvidia_vulkan_icd() {
  local dir

  for dir in \
    /usr/share/vulkan/icd.d \
    /usr/local/share/vulkan/icd.d \
    /etc/vulkan/icd.d \
    "${XDG_DATA_HOME:-$HOME/.local/share}/vulkan/icd.d"; do
    for manifest in "$dir"/*nvidia*.json; do
      if [ -e "$manifest" ]; then
        return 0
      fi
    done
  done

  return 1
}

detect_gpu_variant() {
  local os="$1"
  local arch="$2"
  local pci="" display="" major cuda_variant="" nvidia_gpu=0 other_gpu=0

  # The CUDA and Vulkan builds exist for Linux x86_64 only, and macOS has a
  # single build with Metal always on -- there is no separate CPU build there,
  # so --no-gpu cannot do anything either. Say so rather than staying silent.
  case "$os:$arch" in
  macos:*)
    if [ "$GPU_MODE" != "auto" ]; then
      warn "--gpu ${GPU_MODE} has no effect on macOS: the only macOS build includes Metal, which is always enabled"
    fi
    echo "metal"
    return
    ;;
  linux:x86_64) ;;
  *)
    case "$GPU_MODE" in
    cuda | cuda13 | vulkan)
      warn "--gpu ${GPU_MODE} is Linux x86_64 only; installing the CPU build for ${os}-${arch}"
      ;;
    esac
    echo "cpu"
    return
    ;;
  esac

  if [ "$GPU_MODE" = "cpu" ]; then
    echo "cpu"
    return
  fi

  # An explicit --gpu choice skips detection.
  case "$GPU_MODE" in
  cuda | cuda13 | vulkan)
    echo "$GPU_MODE"
    return
    ;;
  esac

  if has lspci; then
    pci="$(lspci 2>/dev/null || true)"
  fi

  # Only display controllers count for vendor detection. Matching the whole
  # lspci listing let an AMD host bridge or an Intel NIC pass for a GPU, which
  # is how an NVIDIA-only machine used to end up on the AMD/Intel branch.
  # grep and tr consume all of their input here, so there is no early-exit
  # SIGPIPE to worry about.
  display="$(printf '%s\n' "$pci" | grep -Ei 'VGA|3D|Display' | tr '[:upper:]' '[:lower:]' || true)"
  case "$display" in
  *nvidia*) nvidia_gpu=1 ;;
  esac
  case "$display" in
  *"advanced micro devices"* | *"amd"* | *intel*) other_gpu=1 ;;
  esac
  if has nvidia-smi; then
    nvidia_gpu=1
  fi

  if [ "$nvidia_gpu" -eq 1 ]; then
    # libcuda.so.1 comes from the driver and is unversioned across toolkits.
    # libcublas and libcudart come from the toolkit and carry the CUDA major in
    # their soname; a build linked against one major cannot load another, so the
    # variant has to match what is actually installed.
    if has_ld_library 'libcuda.so.1'; then
      for major in 13 12; do
        if [ "$major" = "13" ] && ! supports_cuda13; then
          continue
        fi
        if has_ld_library "libcublas.so.${major}" && has_ld_library "libcudart.so.${major}"; then
          # `|| cuda_variant=""` keeps an unmapped major from aborting the whole
          # installer: this is a bare assignment, so errexit applies to it.
          cuda_variant="$(cuda_variant_for_major "$major")" || cuda_variant=""
          if [ -n "$cuda_variant" ]; then
            break
          fi
        fi
      done
    fi

    if [ -n "$cuda_variant" ]; then
      if [ "$LD_LIBRARY_PATH_HIT" -eq 1 ]; then
        warn "the CUDA libraries were found through LD_LIBRARY_PATH, not the system loader cache"
        warn "make sure LD_LIBRARY_PATH is set in your login shell as well, or ${BIN_NAME} will not start there"
      fi
      echo "$cuda_variant"
      return
    fi

    # The NVIDIA driver ships a Vulkan ICD, so Vulkan is a real GPU fallback
    # here rather than dropping all the way down to CPU -- but only when that
    # ICD is actually installed. libvulkan.so.1 alone proves nothing: the
    # loader is pulled in by Mesa and by desktop packages on essentially every
    # graphical Linux install, including ones where the NVIDIA driver was
    # installed without its Vulkan component. Shipping the Vulkan build to
    # those users produces a binary that starts and then silently runs on CPU,
    # which is harder to diagnose than installing the CPU build outright.
    if has_ld_library 'libvulkan.so.1' && has_nvidia_vulkan_icd; then
      warn "NVIDIA GPU detected, but no complete CUDA runtime was found (need libcublas.so.N and libcudart.so.N for N=12 or 13); installing Vulkan build"
      echo "vulkan"
      return
    fi
    warn "NVIDIA GPU detected, but no complete CUDA runtime (libcublas.so.N and libcudart.so.N for N=12 or 13) and no NVIDIA Vulkan driver were found"
    warn "install a CUDA toolkit, or the NVIDIA Vulkan driver, then rerun to get GPU acceleration"
    # Do not fall through into the AMD/Intel branch on the strength of the
    # NVIDIA card alone. Only a second, AMD or Intel display controller
    # (hybrid graphics) justifies the Vulkan build here, and then it is that
    # GPU which runs it.
    if [ "$other_gpu" -eq 0 ]; then
      warn "installing CPU build"
      echo "cpu"
      return
    fi
    warn "an AMD or Intel GPU is also present; checking whether Vulkan can use it instead"
  fi

  if [ "$other_gpu" -eq 1 ]; then
    if has_ld_library 'libvulkan.so.1'; then
      echo "vulkan"
      return
    fi
    warn "AMD/Intel GPU detected, but Vulkan runtime library was not found; installing CPU build"
  fi

  echo "cpu"
}

# Ordered fallbacks for a detected variant, so a release that does not carry the
# preferred artifact degrades instead of aborting the install.
gpu_variant_fallbacks() {
  case "$1" in
  cuda13) printf '%s\n' cuda13 vulkan cpu ;;
  cuda) printf '%s\n' cuda vulkan cpu ;;
  vulkan) printf '%s\n' vulkan cpu ;;
  *) printf '%s\n' "$1" ;;
  esac
}

# The next variant down the fallback chain from $1, or "cpu" at the end of it.
demote_gpu_variant() {
  local candidate seen=0

  while IFS= read -r candidate; do
    if [ "$seen" -eq 1 ]; then
      printf '%s\n' "$candidate"
      return
    fi
    if [ "$candidate" = "$1" ]; then
      seen=1
    fi
  done < <(gpu_variant_fallbacks "$1")

  printf '%s\n' "cpu"
}

# Installs build $3 by native package when $7 is "native-package", falling back
# to the release archive when the package is unavailable or refused. The
# archive is narrowed from the detected variant $4, not from $3, because $3 may
# already have been narrowed on .deb/.rpm availability. Leaves the result in
# INSTALLED_VARIANT, INSTALLED_BIN and INSTALL_MODE_USED.
install_build() {
  local os="$1"
  local arch="$2"
  local variant="$3"
  local detected="$4"
  local package_kind="$5"
  local pm="$6"
  local mode="$7"
  local rc=0 archive_variant

  INSTALL_MODE_USED="$mode"

  if [ "$mode" = "native-package" ]; then
    if download_and_install_native_package "$package_kind" "$pm" "$os" "$arch" "$variant"; then
      INSTALLED_VARIANT="$variant"
      INSTALLED_BIN="/usr/bin/${BIN_NAME}"
      return 0
    else
      rc=$?
    fi
    case "$rc" in
    1) warn "${VERSION} has no ${variant} ${package_kind} package; falling back to the release archive" ;;
    2) warn "the ${variant} ${package_kind} package could not be downloaded; falling back to the release archive" ;;
    *) warn "${pm} refused the ${variant} ${package_kind} package; falling back to the release archive" ;;
    esac
    INSTALL_MODE_USED="archive"
    archive_variant="$(available_gpu_variant "$os" "$arch" "$detected" "archive")"
    if [ "$archive_variant" != "$variant" ]; then
      variant="$archive_variant"
    fi
  fi

  download_and_install "$os" "$arch" "$variant"
  INSTALLED_BIN="${INSTALL_DIR}/${BIN_NAME}"
}

# Narrows a detected variant to one the target release actually ships.
available_gpu_variant() {
  local os="$1"
  local arch="$2"
  local gpu_variant="$3"
  local kind="$4"
  local candidate

  # Only the manifest can be probed without network round trips. A pinned
  # --version resolves names against the release layout instead, and is left to
  # the download step to sort out.
  if [ -z "$MANIFEST" ]; then
    printf '%s\n' "$gpu_variant"
    return
  fi

  while IFS= read -r candidate; do
    if [ -n "$(manifest_get assets "$(manifest_key "$os" "$arch" "$candidate" "$kind")")" ]; then
      printf '%s\n' "$candidate"
      return
    fi
  done < <(gpu_variant_fallbacks "$gpu_variant")

  printf '%s\n' "cpu"
}

missing_deps() {
  local os="$1"
  local session="$2"
  local deps=()

  if ! has ffmpeg; then
    deps+=("ffmpeg")
  fi

  if [ "$os" = "linux" ]; then
    case "$session" in
    wayland)
      if ! has wl-copy; then deps+=("wl-clipboard"); fi
      ;;
    x11)
      if ! has xclip; then deps+=("xclip"); fi
      ;;
    *)
      if ! has wl-copy; then deps+=("wl-clipboard"); fi
      if ! has xclip; then deps+=("xclip"); fi
      ;;
    esac
  fi

  # Guard the expansion: under `set -u`, "${deps[@]}" on an empty array raises
  # "unbound variable" in bash < 4.4 (notably macOS's default bash 3.2).
  if [ "${#deps[@]}" -gt 0 ]; then
    printf '%s\n' "${deps[@]}"
  fi
}

install_dependencies() {
  local pm="$1"
  shift
  local deps=("$@")

  if [ "${#deps[@]}" -eq 0 ]; then
    return 0
  fi

  case "$pm" in
  brew)
    brew install "${deps[@]}"
    ;;
  apt)
    sudo_cmd apt-get update
    sudo_cmd apt-get install -y "${deps[@]}"
    ;;
  dnf)
    sudo_cmd dnf install -y "${deps[@]}"
    ;;
  zypper)
    sudo_cmd zypper --non-interactive install "${deps[@]}"
    ;;
  pacman)
    sudo_cmd pacman -S --needed --noconfirm "${deps[@]}"
    ;;
  *)
    warn "could not detect a supported package manager"
    warn "please install manually: ${deps[*]}"
    ;;
  esac
}

print_dependency_warning() {
  local os="$1"
  local pm="$2"
  shift 2
  local deps=("$@")

  if [ "${#deps[@]}" -eq 0 ]; then
    return 0
  fi

  if [ "$INSTALL_DEPS" -eq 1 ] && [ "$pm" != "unknown" ]; then
    return 0
  fi

  printf '\n\033[31m▲ Dependency action required\033[0m\n'

  if [ "$INSTALL_DEPS" -eq 0 ]; then
    printf 'Dependency installation was skipped, and these dependencies are missing:\n'
  else
    printf 'No supported package manager was found, so the installer cannot install these dependencies:\n'
  fi

  printf '  %s\n' "${deps[*]}"
  printf '\n'
  printf 'OSTT requires these dependencies for the detected platform/session.\n'
  printf 'Install them before using OSTT, or rerun this installer after installing a supported package manager.\n'
  printf '\n'

  case "$os" in
  macos)
    if [ "$pm" = "unknown" ]; then
      printf 'Recommended fix: install Homebrew, then rerun this installer:\n'
      printf '  https://brew.sh\n'
      printf 'Or install the missing dependencies manually.\n'
    else
      printf 'Install the missing dependencies manually.\n'
    fi
    ;;
  linux)
    printf 'Install the missing dependencies with your system package manager.\n'
    ;;
  esac
}

release_base_url() {
  echo "https://github.com/${REPO}/releases/download/${VERSION}"
}

native_package_kind() {
  local os="$1"
  local arch="$2"
  local pm="$3"

  case "$os:$arch:$pm" in
  linux:x86_64:apt) echo "deb" ;;
  linux:aarch64:apt) echo "deb" ;;
  linux:x86_64:dnf | linux:x86_64:zypper) echo "rpm" ;;
  linux:aarch64:dnf | linux:aarch64:zypper) echo "rpm" ;;
  *) echo "" ;;
  esac
}

download_and_install_native_package() {
  local kind="$1"
  local pm="$2"
  local os="$3"
  local arch="$4"
  local gpu_variant="$5"
  local pkg tmpdir new_name sibling

  # Returns 1 when the release has no such package, 2 when it could not be
  # downloaded, 3 when the package manager refused it. The caller words its
  # fallback message from that, so a refusal is not reported as "unavailable".
  resolve_asset "$os" "$arch" "$gpu_variant" "$kind" || return 1

  pkg="${RESOLVED_URL##*/}"
  tmpdir="$(mktemp -d)"
  trap "rm -rf $(printf '%q' "$tmpdir")" RETURN

  download_verified "$RESOLVED_URL" "$RESOLVED_SHA" "${tmpdir}/${pkg}" || return 2
  chmod 755 "$tmpdir"
  chmod 644 "${tmpdir}/${pkg}"

  # The ostt, ostt-cuda, ostt-cuda13 and ostt-vulkan packages all own
  # /usr/bin/ostt and declare a conflict, so moving from one to another is a
  # replacement. apt does that from the Replaces field. dnf and zypper need to
  # be allowed to remove the outgoing package -- but only then: the flags that
  # permit it are not scoped to one package, so they are passed only when a
  # sibling is actually installed and named explicitly where the tool allows.
  new_name="$(package_name_for_variant "$gpu_variant")"
  sibling="$(installed_sibling_package "$pm" "$new_name")"

  case "$pm" in
  apt)
    # --allow-downgrades: a pinned --version older than what is installed is a
    # downgrade, which apt refuses under -y without it.
    sudo_cmd apt-get install -y --reinstall --allow-downgrades "${tmpdir}/${pkg}" || return 3
    ;;
  dnf)
    if [ -n "$sibling" ]; then
      sudo_cmd dnf swap -y "$sibling" "${tmpdir}/${pkg}" || return 3
    else
      sudo_cmd dnf install -y "${tmpdir}/${pkg}" || return 3
    fi
    ;;
  zypper)
    if [ -n "$sibling" ]; then
      sudo_cmd zypper --non-interactive install --force-resolution "${tmpdir}/${pkg}" || return 3
    else
      sudo_cmd zypper --non-interactive install "${tmpdir}/${pkg}" || return 3
    fi
    ;;
  *)
    return 3
    ;;
  esac
}

package_name_for_variant() {
  case "$1" in
  cuda | cuda13 | vulkan) printf '%s\n' "${BIN_NAME}-$1" ;;
  *) printf '%s\n' "$BIN_NAME" ;;
  esac
}

# Name of an installed ostt package other than $2, or nothing.
installed_sibling_package() {
  local pm="$1"
  local keep="$2"
  local name status

  for name in "$BIN_NAME" "${BIN_NAME}-cuda" "${BIN_NAME}-cuda13" "${BIN_NAME}-vulkan"; do
    [ "$name" != "$keep" ] || continue
    case "$pm" in
    apt)
      status="$(dpkg-query -W -f '${Status}' "$name" 2>/dev/null || true)"
      case "$status" in
      *" installed") printf '%s\n' "$name"; return 0 ;;
      esac
      ;;
    dnf | zypper)
      if rpm -q "$name" >/dev/null 2>&1; then
        printf '%s\n' "$name"
        return 0
      fi
      ;;
    esac
  done

  return 0
}

verify_checksum() {
  local archive_path="$1"
  local expected="$2"
  local actual

  printf '\nVerifying checksum: '
  expected="$(printf '%s\n' "$expected" | tr 'A-Z' 'a-z')"
  if ! printf '%s\n' "$expected" | grep -Eq '^[0-9a-f]{64}$'; then
    die "invalid SHA-256 for $(basename "$archive_path"): ${expected}"
  fi

  if has sha256sum; then
    actual="$(sha256sum "$archive_path" | awk '{print $1}')"
  elif has shasum; then
    actual="$(shasum -a 256 "$archive_path" | awk '{print $1}')"
  elif has openssl; then
    actual="$(openssl dgst -sha256 <"$archive_path" | awk '{print $NF}')"
  else
    die "sha256sum, shasum, or openssl is required to verify the download"
  fi

  if [ "$actual" != "$expected" ]; then
    die "checksum verification failed for $(basename "$archive_path")"
  fi

  printf 'ok\n'
}

check_macos_terminal() {
  local found=0

  if [ -d "/Applications/Ghostty.app" ] || has ghostty; then found=1; fi
  if [ -d "/Applications/kitty.app" ] || has kitty; then found=1; fi
  if [ -d "/Applications/Alacritty.app" ] || has alacritty; then found=1; fi

  if [ "$found" -eq 0 ]; then
    cat <<'EOF'

No supported popup terminal was detected on macOS.

OSTT can still be installed and used from your terminal, but `ostt launch`
requires one of these terminal emulators for popup mode:
  - Ghostty
  - kitty
  - Alacritty

Install one of them before setting up a global hotkey.
EOF
  fi
}

download_and_install() {
  local os="$1"
  local arch="$2"
  local gpu_variant="$3"
  local archive
  local tmpdir
  local extracted_bin
  local candidate

  # Walk the fallback chain rather than aborting. main() already narrowed the
  # variant against the manifest, but a pinned --version has no manifest to
  # narrow against, so this is where an older release that predates the
  # detected variant gets resolved to something it actually published.
  # A download that fails after the manifest listed it is treated the same
  # way as an unlisted one: move on to the next build.
  INSTALLED_VARIANT=""
  tmpdir="$(mktemp -d)"
  trap "rm -rf $(printf '%q' "$tmpdir")" RETURN
  while IFS= read -r candidate; do
    resolve_asset "$os" "$arch" "$candidate" "archive" || continue
    archive="${RESOLVED_URL##*/}"
    if download_verified "$RESOLVED_URL" "$RESOLVED_SHA" "${tmpdir}/${archive}"; then
      INSTALLED_VARIANT="$candidate"
      break
    fi
  done < <(gpu_variant_fallbacks "$gpu_variant")

  if [ -z "$INSTALLED_VARIANT" ]; then
    die "no archive could be downloaded for ${os}-${arch} in ${VERSION}"
  fi
  if [ "$INSTALLED_VARIANT" != "$gpu_variant" ]; then
    warn "${VERSION} has no usable ${gpu_variant} archive for ${os}-${arch}; installing the ${INSTALLED_VARIANT} build instead"
  fi

  tar -xzf "${tmpdir}/${archive}" -C "$tmpdir"
  extracted_bin="$(find "$tmpdir" -type f -name "$BIN_NAME" -perm -111)"
  extracted_bin="${extracted_bin%%$'\n'*}"
  if [ -z "$extracted_bin" ]; then
    die "downloaded archive did not contain an executable ${BIN_NAME} binary"
  fi

  mkdir -p "$INSTALL_DIR"
  install -m 0755 "$extracted_bin" "${INSTALL_DIR}/${BIN_NAME}"
}

xdg_data_home() {
  printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}"
}

xdg_config_home() {
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

is_omarchy() {
  local distro="$1"

  [ "$distro" = "omarchy" ] || {
    has omarchy && { [ -d /usr/share/omarchy ] || [ -d "$HOME/.local/share/omarchy" ]; }
  }
}

backup_config_file() {
  local file="$1"
  local backup

  if [ ! -f "$file" ]; then
    return 0
  fi

  backup="${file}.ostt.bak.$(date +%Y%m%d%H%M%S).$$"
  cp -p "$file" "$backup" || return 1
  printf '%s\n' "$backup"
}

append_config_block() {
  local file="$1"
  local block="$2"
  local backup last_byte separator=""

  mkdir -p "$(dirname "$file")" || return 1
  if [ -e "$file" ] && [ ! -w "$file" ]; then
    return 1
  fi

  backup="$(backup_config_file "$file")" || return 1
  if [ -s "$file" ]; then
    last_byte="$(printf x; tail -c 1 "$file")"
    if [ "$last_byte" = "x" ]; then
      separator=$'\n'
    else
      separator=$'\n\n'
    fi
  fi
  printf '%s%s\n' "$separator" "$block" >>"$file" || {
    [ -n "$backup" ] && cp -p "$backup" "$file"
    return 1
  }

  printf '%s\n' "$backup"
}

shell_quote() {
  local value="$1"
  value=${value//\'/\'\\\'\'}
  printf "'%s'" "$value"
}

lua_escape() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '%s' "$value"
}

lua_binding_exists() {
  local file="$1"
  local key="$2"
  local key_regex alternate_regex=""

  case "$key" in
  "ALT + SPACE")
    key_regex='ALT[[:space:]]*\+[[:space:]]*SPACE'
    ;;
  "ALT + SHIFT + SPACE")
    key_regex='ALT[[:space:]]*\+[[:space:]]*SHIFT[[:space:]]*\+[[:space:]]*SPACE'
    alternate_regex='SHIFT[[:space:]]*\+[[:space:]]*ALT[[:space:]]*\+[[:space:]]*SPACE'
    ;;
  *) return 1 ;;
  esac

  grep -Eiq "^[[:space:]]*(o|hl)\\.bind[[:space:]]*\\([[:space:]]*[\"'](${key_regex}${alternate_regex:+|${alternate_regex}})[\"']" "$file" 2>/dev/null
}

configure_omarchy_bindings() {
  local installed_bin="$1"
  local bindings_file="$2"
  local quoted_bin clipboard_command agent_command clipboard_line agent_line block=""

  quoted_bin="$(shell_quote "$installed_bin")"
  clipboard_command="$(lua_escape "${quoted_bin} launch -c")"
  agent_command="$(lua_escape "${quoted_bin} launch -p agent")"
  clipboard_line="o.bind(\"ALT + SPACE\", \"OSTT\", \"${clipboard_command}\")"
  agent_line="o.bind(\"ALT + SHIFT + SPACE\", \"OSTT to default agent\", \"${agent_command}\")"

  if lua_binding_exists "$bindings_file" "ALT + SPACE"; then
    if grep -qxF "$clipboard_line" "$bindings_file" 2>/dev/null; then
      log "Omarchy clipboard hotkey already configured (ALT+SPACE)."
    else
      warn "ALT+SPACE is already configured; preserving the existing binding"
    fi
  else
    block="$clipboard_line"
  fi

  if lua_binding_exists "$bindings_file" "ALT + SHIFT + SPACE"; then
    if grep -qxF "$agent_line" "$bindings_file" 2>/dev/null; then
      log "Omarchy agent hotkey already configured (ALT+SHIFT+SPACE)."
    else
      warn "ALT+SHIFT+SPACE is already configured; preserving the existing binding"
    fi
  elif [ -n "$block" ]; then
    block="${block}"$'\n'"${agent_line}"
  else
    block="$agent_line"
  fi

  if [ -n "$block" ]; then
    block="-- Added by the OSTT installer."$'\n'"${block}"
    if append_config_block "$bindings_file" "$block" >/dev/null; then
      log "Configured Omarchy hotkeys."
    else
      warn "could not update Omarchy hotkeys"
    fi
  fi
}

configure_omarchy_window() {
  local hyprland_file="$1"
  local block

  if grep -Eq "^[[:space:]]*(title|class|app_id)[[:space:]]*=.*[\"']\\^?ostt(-popup)?\\\$?[\"']" "$hyprland_file" 2>/dev/null ||
    grep -Eq "^[[:space:]]*o\\.window.*(title|class|app_id)[[:space:]]*=.*[\"']\\^?ostt(-popup)?\\\$?[\"']" "$hyprland_file" 2>/dev/null; then
    log "Omarchy OSTT popup rule already configured."
    return 0
  fi

  block='-- Keep OSTT'"'"'s popup above every workspace.
o.window({ title = "^ostt$" }, {
  float = true,
  move = { "((monitor_w*0.5)-(window_w*0.5))", "(monitor_h*0.85)" },
  pin = true,
})'

  if append_config_block "$hyprland_file" "$block" >/dev/null; then
    log "Configured the Omarchy popup."
  else
    warn "could not update the Omarchy popup rule"
  fi
}

configure_omarchy_agent_action() {
  local installed_bin="$1"
  local config_file="$(xdg_config_home)/ostt/ostt.toml"
  local block backup

  # A config-aware command creates and validates the default config on a fresh install.
  if ! "$installed_bin" model current >/dev/null 2>&1; then
    warn "could not initialize OSTT configuration; skipping the Omarchy agent action"
    return 0
  fi

  if grep -Eq '^\[process\.actions\.("agent"|agent)\][[:space:]]*$' "$config_file" 2>/dev/null; then
    log "Omarchy default-agent action already configured."
    return 0
  fi

  block='[process.actions.agent]
name = "Send to default agent"
type = "bash"
command = "setsid -f omarchy agent prompt \"$(cat)\" </dev/null >/dev/null 2>&1"'

  backup="$(append_config_block "$config_file" "$block")" || {
    warn "could not add the Omarchy default-agent action"
    return 0
  }

  if ! "$installed_bin" model current >/dev/null 2>&1; then
    # An empty backup means the file did not exist before the append.
    if [ -n "$backup" ]; then
      cp -p "$backup" "$config_file" || true
    else
      rm -f "$config_file"
    fi
    warn "the Omarchy agent action was not valid and has been rolled back"
    return 0
  fi

  log "Configured the Omarchy default-agent action."
}

configure_omarchy() {
  local installed_bin="$1"
  local config_home hyprland_file bindings_file errors default_agent

  if [ "$(id -u)" -eq 0 ]; then
    warn "running as root; skipping user-level Omarchy configuration"
    return 0
  fi

  config_home="$(xdg_config_home)"
  hyprland_file="${config_home}/hypr/hyprland.lua"
  bindings_file="${config_home}/hypr/bindings.lua"

  configure_omarchy_agent_action "$installed_bin"

  if [ -f "$hyprland_file" ]; then
    configure_omarchy_bindings "$installed_bin" "$bindings_file"
    configure_omarchy_window "$hyprland_file"

    if has hyprctl && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
      if hyprctl reload >/dev/null 2>&1; then
        errors="$(hyprctl configerrors 2>/dev/null || true)"
        if [ -n "$errors" ]; then
          warn "Hyprland reported configuration errors:"
          printf '%s\n' "$errors" >&2
        else
          log "Reloaded Hyprland configuration."
        fi
      else
        warn "could not reload Hyprland; the new configuration will load next session"
      fi
    fi
  else
    warn "Omarchy 4 Hyprland configuration was not found; skipping hotkeys and popup rule"
  fi

  default_agent=""
  if has omarchy-default-agent; then
    default_agent="$(omarchy-default-agent 2>/dev/null || true)"
  fi
  if [ -z "$default_agent" ]; then
    printf '\nℹ️  No Omarchy default agent has been configured. Choose an agent: \033[1;32momarchy agent --pick\033[0m\n'
  else
    log "Omarchy default agent: ${default_agent}."
  fi
}

print_model_hint() {
  printf '\nA transcription model is required before recording. Configure a model: \033[1;32mostt model\033[0m\n'
}

# Leaves the install ready to transcribe: when no model is active, select the
# Whisper base model if it is already on disk (reinstall/upgrade), otherwise
# offer to download it. Falls back to printing the `ostt model` hint.
offer_default_model() {
  local installed_bin="$1"
  local selected_model answer
  local base_model_file="$(xdg_data_home)/ostt/models/base.bin"

  selected_model="$("$installed_bin" model current 2>/dev/null || true)"
  if [ -n "$selected_model" ] && [ "$selected_model" != "No model selected." ]; then
    printf '\nTranscription model: %s\n' "$selected_model"
    return 0
  fi

  if [ -f "$base_model_file" ]; then
    if "$installed_bin" model select whisper/base >/dev/null 2>&1; then
      log "Selected the already-downloaded Whisper base model (whisper/base)."
      return 0
    fi
  fi

  if [ "$DOWNLOAD_MODEL" -eq 0 ]; then
    print_model_hint
    return 0
  fi

  # Without a controlling terminal there is nobody to ask.
  if ! { : </dev/tty; } 2>/dev/null; then
    print_model_hint
    return 0
  fi

  printf '\nOSTT transcribes with a cloud or local model; configure one with `ostt model`.\nOr start right away with the small Whisper base model (142 MB).\n'
  printf 'Download it now? [Y/n] '
  if ! read -r answer 2>/dev/null </dev/tty; then
    printf '\n'
    print_model_hint
    return 0
  fi
  case "$answer" in
  '' | Y | y | YES | Yes | yes)
    if "$installed_bin" model local download base &&
      "$installed_bin" model select whisper/base >/dev/null 2>&1; then
      log "Whisper base model downloaded and selected; OSTT is ready to transcribe."
    else
      warn "could not download or select the Whisper base model"
      print_model_hint
    fi
    ;;
  *)
    print_model_hint
    ;;
  esac
}

# Profile file we append PATH / fpath lines to, per shell.
shell_profile() {
  local shell_name="$1"
  local os="$2"

  case "$shell_name" in
  fish) printf '%s\n' "${HOME}/.config/fish/config.fish" ;;
  zsh) printf '%s\n' "${ZDOTDIR:-$HOME}/.zshrc" ;;
  bash)
    # macOS terminals start login shells, which read .bash_profile, not .bashrc.
    if [ "$os" = "macos" ]; then
      printf '%s\n' "${HOME}/.bash_profile"
    else
      printf '%s\n' "${HOME}/.bashrc"
    fi
    ;;
  *) printf '%s\n' "${HOME}/.profile" ;;
  esac
}

# Append a line to a profile unless it is already there. Idempotent across
# reruns of the installer.
append_to_profile() {
  local profile="$1"
  local line="$2"

  if [ -f "$profile" ] && grep -qxF "$line" "$profile" 2>/dev/null; then
    return 0
  fi

  mkdir -p "$(dirname "$profile")" || return 1
  {
    printf '\n# added by the %s installer\n' "$APP_NAME"
    printf '%s\n' "$line"
  } >>"$profile" || return 1
}

install_completions() {
  local installed_bin="$1"
  local shell_name="$2"
  local os="$3"
  local dir line profile

  case "$shell_name" in
  bash)
    # bash-completion 2.x loads user completions from XDG_DATA_HOME with no
    # extra configuration, so this needs no sudo and no profile edit.
    dir="$(xdg_data_home)/bash-completion/completions"
    mkdir -p "$dir" || return 1
    if "$installed_bin" completions bash 2>/dev/null >"${dir}/${BIN_NAME}"; then
      log "Shell completions installed for bash."
    else
      rm -f "${dir}/${BIN_NAME}"
      warn "could not install shell completions for bash; run manually:"
      warn "  ${BIN_NAME} completions bash > ${dir}/${BIN_NAME}"
    fi
    ;;
  zsh)
    # zsh's default fpath contains no directory under $HOME, so unlike bash
    # a user-local completion also needs an fpath entry in .zshrc.
    dir="$(xdg_data_home)/zsh/site-functions"
    mkdir -p "$dir" || return 1
    if "$installed_bin" completions zsh 2>/dev/null >"${dir}/_${BIN_NAME}"; then
      log "Shell completions installed for zsh."
    else
      rm -f "${dir}/_${BIN_NAME}"
      warn "could not install shell completions for zsh; run manually:"
      warn "  ${BIN_NAME} completions zsh > ${dir}/_${BIN_NAME}"
      return 0
    fi

    case ":${FPATH:-}:" in
    *":${dir}:"*) return 0 ;;
    esac

    profile="$(shell_profile zsh "$os")"
    line="fpath=(\"${dir}\" \$fpath)"
    if [ "$MODIFY_PATH" -eq 1 ] && append_to_profile "$profile" "$line"; then
      :
    else
      log "To enable them, add this to ${profile}:"
      log "  ${line}"
    fi
    ;;
  fish)
    dir="$HOME/.config/fish/completions"
    mkdir -p "$dir" || return 1
    if "$installed_bin" completions fish 2>/dev/null >"${dir}/${BIN_NAME}.fish"; then
      log "Shell completions installed for fish."
    else
      rm -f "${dir}/${BIN_NAME}.fish"
      warn "could not install shell completions for fish; run manually:"
      warn "  ${BIN_NAME} completions fish > ${dir}/${BIN_NAME}.fish"
    fi
    ;;
  esac
}

main() {
  local os arch distro pm session triple package_kind install_mode installed_bin gpu_variant detected_variant next_variant on_path
  local current_bin current_version target_release pm_label source_label
  local omarchy_detected=0
  local deps=()

  print_header
  check_prerequisites

  current_bin="$(installed_ostt_path)"
  current_version="$(installed_ostt_version "$current_bin")"

  if [ "$VERSION" = "latest" ]; then
    fetch_manifest
    target_release="v$(manifest_version)"
    if [ "$target_release" = "v" ]; then
      die "release manifest at ${MANIFEST_URL} has no version field"
    fi
    VERSION="$target_release"
    source_label="manifest"
    warn_if_manifest_stale
  else
    # A pinned version predates the manifest, which only ever describes the
    # latest release, so this path derives asset names from the release layout.
    target_release="$VERSION"
    source_label="pinned"
  fi

  os="$(detect_os)"
  arch="$(detect_arch)"
  distro="unknown"
  session="unknown"
  if [ "$os" = "linux" ]; then
    distro="$(detect_distro)"
    session="$(detect_session)"
    if is_omarchy "$distro"; then
      omarchy_detected=1
    fi
  fi
  pm="$(detect_package_manager "$os")"
  pm_label="$pm"
  if [ "$pm" = "unknown" ]; then
    pm_label="not found"
  fi
  triple="$(target_triple "$os" "$arch")"
  package_kind="$(native_package_kind "$os" "$arch" "$pm")"
  install_mode="archive"
  if [ -n "$package_kind" ] && [ "$INSTALL_DIR" = "$DEFAULT_INSTALL_DIR" ] && [ "$INSTALL_DEPS" -eq 1 ]; then
    install_mode="native-package"
  fi

  detected_variant="$(detect_gpu_variant "$os" "$arch")"
  # The detected variant is what this machine can run; narrow it to what the
  # target release actually publishes before anything is downloaded. The
  # detected value is kept: if the package path falls back to the archive,
  # the archive gets narrowed from it afresh rather than inheriting a
  # narrowing that was about .deb/.rpm availability.
  if [ "$install_mode" = "native-package" ]; then
    gpu_variant="$(available_gpu_variant "$os" "$arch" "$detected_variant" "$package_kind")"
  else
    gpu_variant="$(available_gpu_variant "$os" "$arch" "$detected_variant" "archive")"
  fi
  if [ "$gpu_variant" != "$detected_variant" ]; then
    warn "${VERSION} has no ${detected_variant} build for ${os}-${arch}; installing the ${gpu_variant} build instead"
  fi

  if [ "$os" = "macos" ]; then
    check_macos_terminal
  fi

  if [ "$INSTALL_DEPS" -eq 1 ]; then
    while IFS= read -r dep; do
      [ -n "$dep" ] && deps+=("$dep")
    done < <(missing_deps "$os" "$session")
  fi

  if [ "$INTERACTIVE" -eq 1 ]; then
    printf 'Detected:\n'
    printf '  OS: %s\n' "$os"
    printf '  Architecture: %s\n' "$arch"
    printf '  Target: %s\n' "$triple"
    if [ "$os" = "linux" ]; then
      printf '  Distro: %s\n' "$distro"
      printf '  Session: %s\n' "$session"
    fi
    printf '  Package manager: %s\n' "$pm_label"
    printf '  GPU build: %s\n' "$gpu_variant"
    if [ -n "$current_bin" ]; then
      if [ -n "$current_version" ]; then
        printf '  Current OSTT: %s (%s)\n' "$current_version" "$current_bin"
      else
        printf '  Current OSTT: installed, version unknown (%s)\n' "$current_bin"
      fi
    else
      printf '  Current OSTT: not found\n'
    fi
    printf '  Target OSTT: %s (%s)\n' "$target_release" "$source_label"
    printf '\nWill install:\n'

    if [ "$install_mode" = "native-package" ]; then
      printf '  method: native %s package via %s\n' "$package_kind" "$pm"
      printf '  %s -> /usr/bin/%s\n' "$BIN_NAME" "$BIN_NAME"
    else
      printf '  method: release archive\n'
      printf '  %s -> %s/%s\n' "$BIN_NAME" "$INSTALL_DIR" "$BIN_NAME"
    fi

    if [ "$INSTALL_DEPS" -eq 1 ] && [ "${#deps[@]}" -gt 0 ]; then
      printf '  dependencies: %s\n' "${deps[*]}"
    elif [ "$INSTALL_DEPS" -eq 0 ]; then
      printf '  dependencies: skipped\n'
    else
      printf '  dependencies: already satisfied\n'
    fi
    if [ "$omarchy_detected" -eq 1 ]; then
      if [ "$CONFIGURE_OMARCHY" -eq 1 ]; then
        printf '  Omarchy: ALT+SPACE dictation, ALT+SHIFT+SPACE default agent, popup rule\n'
      else
        printf '  Omarchy setup: skipped\n'
      fi
    fi
    printf '\n'
  fi

  # Guard the expansion: under `set -u`, "${deps[@]}" on an empty array raises
  # "unbound variable" in bash < 4.4 (notably macOS's default bash 3.2).
  if [ "${#deps[@]}" -gt 0 ]; then
    print_dependency_warning "$os" "$pm" "${deps[@]}"
  fi

  confirm

  if [ "$INSTALL_DEPS" -eq 1 ] && [ "${#deps[@]}" -gt 0 ]; then
    install_dependencies "$pm" "${deps[@]}"
  fi

  install_build "$os" "$arch" "$gpu_variant" "$detected_variant" "$package_kind" "$pm" "$install_mode"
  install_mode="$INSTALL_MODE_USED"
  installed_bin="$INSTALLED_BIN"
  gpu_variant="$INSTALLED_VARIANT"

  # Detection predicts whether the loader can resolve a GPU build's libraries;
  # running the binary proves it. A GPU build that cannot start is stepped
  # down the fallback chain -- on the package path too, where the broken
  # package has by now replaced whatever was there, so leaving it is not an
  # option. macOS has only one build, so there is nothing to step down to.
  if ! "$installed_bin" --version >/dev/null 2>&1; then
    while [ "$os" != "macos" ] && [ "$gpu_variant" != "cpu" ]; do
      next_variant="$(demote_gpu_variant "$gpu_variant")"
      warn "the ${gpu_variant} build could not start on this machine; trying the ${next_variant} build"
      install_build "$os" "$arch" "$next_variant" "$next_variant" "$package_kind" "$pm" "$install_mode"
      install_mode="$INSTALL_MODE_USED"
      installed_bin="$INSTALLED_BIN"
      gpu_variant="$INSTALLED_VARIANT"
      if "$installed_bin" --version >/dev/null 2>&1; then
        break
      fi
    done
  fi

  if ! "$installed_bin" --version >/dev/null 2>&1; then
    die "installed binary at ${installed_bin} did not respond to '${BIN_NAME} --version'; reinstall with --no-gpu to force the CPU build"
  fi

  # A package install lands in /usr/bin, but an earlier archive install in
  # ~/.local/bin is usually ahead of it on PATH and would keep running instead.
  if [ "$install_mode" = "native-package" ]; then
    hash -r 2>/dev/null || true
    on_path="$(command -v "$BIN_NAME" 2>/dev/null || true)"
    if [ -n "$on_path" ] && [ "$on_path" != "$installed_bin" ]; then
      warn "${on_path} comes before ${installed_bin} on your PATH and is what '${BIN_NAME}' will run; remove it to use the package"
    fi
  fi

  local shell_name path_action="none" profile="" path_line=""
  shell_name="$(basename "${SHELL:-/bin/bash}")"

  if [ "$install_mode" != "native-package" ]; then
    printf '\n'
    # Completions are a nicety; an unwritable data directory must not turn a
    # finished install into a non-zero exit with no success message.
    install_completions "$installed_bin" "$shell_name" "$os" || warn "shell completions were not installed"
  fi

  # Native packages land in /usr/bin, which is always on PATH.
  if [ "$install_mode" != "native-package" ] && [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
    profile="$(shell_profile "$shell_name" "$os")"

    case "$shell_name" in
    fish) path_line="fish_add_path \"${INSTALL_DIR}\"" ;;
    *) path_line="export PATH=\"${INSTALL_DIR}:\$PATH\"" ;;
    esac

    if [ "$MODIFY_PATH" -eq 1 ] && append_to_profile "$profile" "$path_line"; then
      path_action="added"
    else
      path_action="manual"
    fi
  fi

  if [ "$omarchy_detected" -eq 1 ] && [ "$CONFIGURE_OMARCHY" -eq 1 ]; then
    configure_omarchy "$installed_bin"
  fi

  # Name the build that was actually installed: with the fallbacks above it is
  # not always the one detection chose.
  printf '\n✅ %s installed successfully: %s\n' "$APP_NAME" "$("$installed_bin" --version 2>/dev/null || printf '%s' "$BIN_NAME")"

  case "$path_action" in
  added)
    cat <<EOF

Added ${INSTALL_DIR} to your PATH in ${profile}.

Start a new shell, or run this once in the current one:
  ${path_line}

EOF
    ;;
  manual)
    cat <<EOF

Note: ${INSTALL_DIR} is not on your PATH yet.

Add it to ${profile}:
  ${path_line}

EOF
    ;;
  *)
    ;;
  esac

  offer_default_model "$installed_bin"
}

if [ "${OSTT_INSTALLER_SOURCE_ONLY:-0}" -eq 0 ]; then
  main "$@"
fi
